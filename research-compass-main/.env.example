# =========================================================
# 🔬 THE AUTONOMOUS RESEARCH SCIENTIST - ENVIRONMENT CONFIG
# =========================================================

# ---------------------------------------------------------
# Supabase Configuration (Authentication, Database & RLS)
# ---------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# ---------------------------------------------------------
# Research Paper APIs
# ---------------------------------------------------------
# OpenAlex: Recommended to supply an email for the Polite Pool (higher rate limit)
OPENALEX_EMAIL=researcher@example.com
VITE_OPENALEX_EMAIL=researcher@example.com

# Semantic Scholar API Key (Optional, higher throughput)
SEMANTIC_SCHOLAR_API_KEY=
VITE_SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------
# LLM AI Service Configuration
# Supports OpenAI, Anthropic, Gemini, Groq, OpenRouter, or custom OpenAI-compatible endpoints
# ---------------------------------------------------------
LLM_API_KEY=
VITE_LLM_API_KEY=
LLM_PROVIDER=openai
VITE_LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
VITE_LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
VITE_LLM_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------
# Python FastAPI Backend (Optional / Standalone service)
# ---------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000
